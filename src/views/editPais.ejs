<div class="container mx-auto px-4 py-8 max-w-2xl">
    
    <div class="mb-6">
        <a href="/dashboard" class="inline-flex items-center gap-2 text-sm font-medium text-gray-500 hover:text-gray-700 transition duration-150">
            <svg xmlns="http://www.w3.org/2000/xl" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
            </svg>
            Volver al Dashboard
        </a>
    </div>

    <div class="bg-white rounded-2xl shadow-sm border border-gray-200 overflow-hidden">
        
        <div class="bg-gradient-to-r from-blue-600 to-indigo-600 px-6 py-5 text-white flex justify-between items-center">
            <div>
                <h1 class="text-xl font-bold">Editar: <%= pais.nombreOficial %></h1>
                <p class="text-blue-100 text-xs mt-1">Modifica los campos del registro actual en la base de datos.</p>
            </div>
            <% if (pais.bandera) { %>
                <img src="<%= pais.bandera %>" alt="Bandera actual" class="h-10 w-16 object-cover rounded-md border border-white/20 shadow-sm">
            <% } %>
        </div>

        <form id="editForm" class="p-6 space-y-5">
            
            <div>
                <label for="nombreOficial" class="block text-sm font-medium text-gray-700 mb-1">Nombre Oficial:</label>
                <input type="text" id="nombreOficial" name="nombreOficial" value="<%= pais.nombreOficial %>" maxlength="90" minlength="3" required
                       class="w-full px-3 py-2 border border-gray-300 rounded-xl shadow-sm focus:outline-none focus:ring-2 focus:ring-blue-500 text-sm">
            </div>

            <div>
                <label for="capital" class="block text-sm font-medium text-gray-700 mb-1">Capital (separados por coma):</label>
                <input type="text" id="capital" name="capital" value="<%= pais.capital.join(', ') %>" maxlength="90" minlength="3" required
                       class="w-full px-3 py-2 border border-gray-300 rounded-xl shadow-sm focus:outline-none focus:ring-2 focus:ring-blue-500 text-sm">
            </div>

            <div>
                <label for="limites" class="block text-sm font-medium text-gray-700 mb-1">Límites / Fronteras (3 letras mayúsculas, separados por comas):</label>
                <input type="text" id="limites" name="limites" value="<%= pais.borders.join(', ') %>" required
                       pattern="^[A-Z]{3}(,[A-Z]{3})*$" title="Tres letras mayúsculas separadas por coma (ej. CHI, BOL)"
                       class="w-full px-3 py-2 border border-gray-300 rounded-xl shadow-sm focus:outline-none focus:ring-2 focus:ring-blue-500 text-sm">
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                <div>
                    <label for="area" class="block text-sm font-medium text-gray-700 mb-1">Área (km²):</label>
                    <input type="number" id="area" name="area" value="<%= pais.area %>" required min="1"
                           class="w-full px-3 py-2 border border-gray-300 rounded-xl shadow-sm focus:outline-none focus:ring-2 focus:ring-blue-500 text-sm">
                </div>
                <div>
                    <label for="poblacion" class="block text-sm font-medium text-gray-700 mb-1">Población:</label>
                    <input type="number" id="poblacion" name="poblacion" value="<%= pais.population %>" required min="1"
                           class="w-full px-3 py-2 border border-gray-300 rounded-xl shadow-sm focus:outline-none focus:ring-2 focus:ring-blue-500 text-sm">
                </div>
            </div>

            <div>
                <label for="zonasHorarias" class="block text-sm font-medium text-gray-700 mb-1">Zonas Horarias (separadas por comas):</label>
                <input type="text" id="zonasHorarias" name="zonasHorarias" value="<%= pais.timezones.join(', ') %>"
                       class="w-full px-3 py-2 border border-gray-300 rounded-xl shadow-sm focus:outline-none focus:ring-2 focus:ring-blue-500 text-sm">
            </div>

            <div>
                <label for="bandera" class="block text-sm font-medium text-gray-700 mb-1">URL de la Bandera (Link SVG o PNG):</label>
                <input type="url" id="bandera" name="bandera" value="<%= pais.bandera %>" required
                       class="w-full px-3 py-2 border border-gray-300 rounded-xl shadow-sm focus:outline-none focus:ring-2 focus:ring-blue-500 text-sm">
            </div>

            <div>
                <label for="creador" class="block text-sm font-medium text-gray-400 mb-1">Creador:</label>
                <input type="text" id="creador" name="creador" value="<%= pais.creador %>" readonly
                       class="w-full px-3 py-2 border border-gray-200 bg-gray-50 text-gray-400 rounded-xl text-sm outline-none cursor-not-allowed">
            </div>

            <div class="pt-4 flex justify-end gap-3">
                <a href="/dashboard" class="bg-gray-100 hover:bg-gray-200 text-gray-700 font-medium py-2.5 px-5 rounded-xl text-sm transition duration-150 border border-gray-300">
                    Cancelar
                </a>
                <button type="submit" class="bg-blue-600 hover:bg-blue-700 text-white font-semibold py-2.5 px-6 rounded-xl text-sm shadow-sm transition duration-150">
                    Actualizar País
                </button>
            </div>
        </form>
    </div>
</div>

<script>
    document.getElementById("editForm").addEventListener("submit", async (e) => {
        e.preventDefault();

        const form = e.target;

        // Función para convertir CSV en array limpio
        const splitCSV = (val) =>
            val
                .split(",")
                .map((s) => s.trim())
                .filter(Boolean);

        // Obtener y limpiar datos
        const nombreOficial = form.nombreOficial.value.trim();
        const capital = splitCSV(form.capital.value);
        const limites = splitCSV(form.limites.value);  
        const area = form.area.value;
        const poblacion = form.poblacion.value;
        const zonasHorarias = splitCSV(form.zonasHorarias.value);
        const bandera = form.bandera.value.trim();
        const creador = form.creador.value.trim();    

        // =========================
        // VALIDACIONES
        // =========================
        const errors = [];
        
        // nombreOficial
        if (!nombreOficial) {
            errors.push("El nombre oficial es obligatorio.");
        } else {
            if (nombreOficial.length < 3) errors.push("El nombre oficial debe tener mínimo 3 caracteres.");
            if (nombreOficial.length > 90) errors.push("El nombre oficial debe tener máximo 90 caracteres.");
        }
        
        // capital
        if (capital.length === 0) {
            errors.push("La capital es obligatoria.");
        } else {
            capital.forEach((cap, index) => {
                if (cap.length < 3) errors.push(`La capital "${cap}" debe tener mínimo 3 caracteres.`);
                if (cap.length > 90) errors.push(`La capital "${cap}" debe tener máximo 90 caracteres.`);
            });
        }
        
        // limites
        if (limites.length > 0) {
            limites.forEach((limite, index) => {
                if (!/^[A-Z]{3}$/.test(limite)) {
                    errors.push(`El límite #${index + 1} "${limite}" debe ser un código de 3 letras mayúsculas.`);
                }
            });
        }

        // area
        if (isNaN(area) || area <= 0) {
            errors.push("El área debe ser un número positivo.");
        }
        
        // poblacion
        if (isNaN(poblacion) || poblacion <= 0 || !Number.isInteger(Number(poblacion))) {
            errors.push("La población debe ser un número entero positivo.");
        }
        
        // bandera
        if (!bandera) {
            errors.push("La URL de la bandera es obligatoria.");
        }
        
        // Mostrar errores
        if (errors.length > 0) {
            alert("Por favor corrige los siguientes errores:\n\n" + errors.join("\n"));
            return;
        }
        
        // Crear body estructurado exactamente como lo espera Mongoose
        const body = {
            nombreOficial, 
            capital,
            borders: limites,      
            area: Number(area),
            population: Number(poblacion), 
            timezones: zonasHorarias,
            bandera,
            creador,
            tipoDocumento: "pais"  
        };

        try {
            const res = await fetch("/api/paises/id/<%= pais._id %>", {
                method: "PUT",
                headers: {
                    "Content-Type": "application/json",
                },
                body: JSON.stringify(body),
            });

            if (res.ok) {
                alert("¡País actualizado con éxito!");
                window.location.href = "/dashboard";
            } else {
                const error = await res.json();
                alert("Error al guardar: " + (error.message || JSON.stringify(error)));
            }
        } catch (error) {
            console.error(error);
            alert("Error crítico de conexión");
        }
    });
</script>
