<div class="container mx-auto px-4 py-8 max-w-2xl">
    
    <div class="mb-6">
        <a href="/dashboard" class="inline-flex items-center gap-2 text-sm font-medium text-gray-500 hover:text-gray-700 transition duration-150">
            Volver al Dashboard
        </a>
    </div>

    <div class="bg-white rounded-2xl shadow-sm border border-gray-200 overflow-hidden">
        
        <div>
            <h1>Agregar Nuevo País</h1>
            <p>Registra un nuevo país de forma manual.</p>
        </div>

        <form id="addPaisForm">
            
            <div>
                <label for="nombreOficial">Nombre Oficial:</label>
                <input type="text" id="nombreOficial" name="nombreOficial" maxlength="90" minlength="3" required placeholder="Ej. República Argentina">
            </div>

            <div>
                <label for="capital">Capital (separados por coma):</label>
                <input type="text" id="capital" name="capital" required placeholder="Ciudad Automona de Buenos Aires">
            </div>

            <div>
                <label for="limites" >Límites / Fronteras (3 letras mayúsculas, separados por comas):</label>
                <input type="text" id="limites" name="limites"                       
                       placeholder="Ej. CHI, URY, BRA, PRY">
            </div>

            <div>
                <div>
                    <label for="area">Área (km²):</label>
                    <input type="number" id="area" name="area" required min="1"                           
                           placeholder="51100">
                </div>
                <div>
                    <label for="poblacion">Población:</label>
                    <input type="number" id="poblacion" name="poblacion" required min="1"                           
                           placeholder="5150000">
                </div>
            </div>

            <div>
                <label for="zonasHorarias">Zonas Horarias (separadas por comas):</label>
                <input type="text" id="zonasHorarias" name="zonasHorarias">
            </div>

            <div>
                <label for="bandera">URL de la Bandera (Link SVG o PNG):</label>
                <input type="url" id="bandera" name="bandera" required         
                       placeholder="https://flagpedia.net/argentina">
            </div>

            <div>
                <label for="creador" >Creador:</label>
                <input type="text" id="creador" name="creador" value="Fernanda" readonly>
            </div>

            <div>
                <button type="submit">
                    Agregar País
                </button>
            </div>
        </form>
    </div>
</div>
<script>
    document.getElementById('addPaisForm').addEventListener('submit', async function (event) {
        event.preventDefault();

        //Obtener y limpiar los valores del formulario
        const nombre = document.getElementById('nombreOficial').value.trim();
        //const capital = document.getElementById('capital').value.trim() || 'N/A';
        const limites = document.getElementById('limites').value.split(',').map(l => l.trim()).filter(l => l);
        const area = parseFloat(document.getElementById('area').value);
        const poblacion = parseInt(document.getElementById('poblacion').value);
        const zonasHorarias = document.getElementById('zonasHorarias').value.split(',').map(z => z.trim()).filter(z => z);
        const creador = document.getElementById('creador').value.trim() || 'Fernanda';

        const capital = document.getElementById('capital')
            .value
            .split(',')
            .map(p => p.trim())
            .filter(p => p !== '');

        // =========================
        // VALIDACIONES
        // =========================
        const errors = [];

        // nombrePais: obligatorio, entre 3 y 90 caracteres
        if (!nombreOficial) {
            errors.push("El nombre del país es obligatorio.");
        } else {
            if (nombreOficial.length < 3) {
                errors.push("El nombre del país debe tener mínimo 3 caracteres.");
            }

            if (nombreOficial.length > 90) {
                errors.push("El nombre del país debe tener máximo 90 caracteres.");
            }
        }
        //capital: obligatorio, al menos una capital, cada una entre 3 y 90 caracteres
        if (capital.length === 0) {
            errors.push("Debes agregar al menos una capital.");
        } else {

            capital.forEach((cap, index) => {

                if (!cap.trim()) {
                    errors.push(`La capital #${index + 1} no puede estar vacía.`);
                }

                if (cap.length < 3) {
                    errors.push(`La capital "${cap}" debe tener mínimo 3 caracteres.`);
                }

                if (cap.length > 90) {
                    errors.push(`La capital "${cap}" debe tener máximo 60 caracteres.`);
                }
            });
        }
        // limites: opcional, si se ingresa debe ser un array de strings,
        // cada limite 3 letras mayúsculas
        if (limites.length > 0) {
            limites.forEach((limite, index) => {
                if (!/^[A-Z]{3}$/.test(limite)) {
                    errors.push(`El límite #${index + 1} "${limite}" debe ser un código de 3 letras mayúsculas.`);
                }
            });
        }
        //Capital: obligatorio, al menos una capital, cada una entre 3 y 90 caracteres
        if (!cap.trim()) {
            errors.push(`La capital #${index + 1} no puede estar vacía.`);
        }

        if (cap.length < 3) {
            errors.push(`La capital "${cap}" debe tener mínimo 3 caracteres.`);
        }

        if (cap.length > 90) {
            errors.push(`La capital "${cap}" debe tener máximo 60 caracteres.`);
        }
    });

    // area: obligatorio, número positivo   
    if (isNaN(area) || area <= 0) {
        errors.push("El área debe ser un número positivo.");
    }
    // población: obligatorio, número entero positivo
    if (isNaN(poblacion) || poblacion <= 0 || !Number.isInteger(poblacion)) {
        errors.push("La población debe ser un número entero positivo.");
    }

    // Si hay errores, mostrar alert con todos los mensajes
    if (errors.length > 0) {
        alert("Por favor corrige los siguientes errores:\n\n" + errors.join("\n"));
        return; // Detener el envío del formulario
    }

    //Crear objeto con los datos del formulario
    const data = {
        nombre,
        capital,
        limites,
        area,
        poblacion,
        zonasHorarias,
        creador
    };

    try {
        const response = await fetch('/api/paises', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json'
            },
            body: JSON.stringify({
                nombre,
                capital,
                limites,
                area,
                poblacion,
                zonasHorarias,
                creador
            })
        });

        if (response.ok) {
            alert('País agregado exitosamente');
            location.href = '/dashboard';
        } else {
            const errorData = await response.json();
            console.error('Error:', errorData);
            alert('Error al agregar el país');
        }
    } catch (error) {
        console.error('Error:', error);
        alert('Error al agregar el país');
    }

</script>