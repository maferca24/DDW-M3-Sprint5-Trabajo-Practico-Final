<div class="container mx-auto px-4 py-8 max-w-2xl">
    
    <div class="mb-6">
        <a href="/dashboard" class="inline-flex items-center gap-2 text-sm font-medium text-gray-500 hover:text-gray-700 transition duration-150">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
            </svg>
            Volver al Dashboard
        </a>
    </div>

    <div class="bg-white rounded-2xl shadow-sm border border-gray-200 overflow-hidden">
        
        <div class="bg-gradient-to-r from-blue-600 to-indigo-600 px-6 py-5 text-white">
            <h1 class="text-xl font-bold">Agregar Nuevo País</h1>
            <p class="text-blue-100 text-xs mt-1">Registra un nuevo país de forma manual.</p>
        </div>

        <form id="addPaisForm" class="p-6 space-y-5">
            
            <div>
                <label for="nombreOficial" class="block text-sm font-medium text-gray-700 mb-1">Nombre Oficial:</label>
                <input type="text" id="nombreOficial" name="nombreOficial" maxlength="90" minlength="3" required
                       class="w-full px-3 py-2 border border-gray-300 rounded-xl shadow-sm focus:outline-none focus:ring-2 focus:ring-blue-500 text-sm"
                       placeholder="Ej. República Argentina">
            </div>

            <div>
                <label for="capital" class="block text-sm font-medium text-gray-700 mb-1">Capital (separados por coma):</label>
                <input type="text" id="capital" name="capital" maxlength="90" minlength="3" required
                       class="w-full px-3 py-2 border border-gray-300 rounded-xl shadow-sm focus:outline-none focus:ring-2 focus:ring-blue-500 text-sm"
                       placeholder="Ej. Ciudad Autonoma de Buenos Aires">
            </div>
            <div>
                <label for="limites" class="block text-sm font-medium text-gray-700 mb-1">Límites / Fronteras (3 letras mayúsculas, separados por comas):</label>
                <input type="text" id="limites" name="limites" required pattern="^[A-Z]{3}(,[A-Z]{3})*$" title="Tres letras mayúsculas separadas por coma (ej. CHI,BOL)""
                       class="w-full px-3 py-2 border border-gray-300 rounded-xl shadow-sm focus:outline-none focus:ring-2 focus:ring-blue-500 text-sm"
                       placeholder="Ej. CHI, BOL">
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                <div>
                    <label for="area" class="block text-sm font-medium text-gray-700 mb-1">Área (km²):</label>
                    <input type="number" id="area" name="area" required min="1"
                           class="w-full px-3 py-2 border border-gray-300 rounded-xl shadow-sm focus:outline-none focus:ring-2 focus:ring-blue-500 text-sm"
                           placeholder="51100">
                </div>
                <div>
                    <label for="poblacion" class="block text-sm font-medium text-gray-700 mb-1">Población:</label>
                    <input type="number" id="poblacion" name="poblacion" required min="1"
                           class="w-full px-3 py-2 border border-gray-300 rounded-xl shadow-sm focus:outline-none focus:ring-2 focus:ring-blue-500 text-sm"
                           placeholder="5150000">
                </div>
            </div>

            <div>
                <label for="zonasHorarias" class="block text-sm font-medium text-gray-700 mb-1">Zonas Horarias (separadas por comas):</label>
                <input type="text" id="zonasHorarias" name="zonasHorarias"
                       class="w-full px-3 py-2 border border-gray-300 rounded-xl shadow-sm focus:outline-none focus:ring-2 focus:ring-blue-500 text-sm"
                       placeholder="Ej. UTC-06:00">
            </div>

            <div>
                <label for="bandera" class="block text-sm font-medium text-gray-700 mb-1">URL de la Bandera (Link SVG o PNG):</label>
                <input type="url" id="bandera" name="bandera" required
                       class="w-full px-3 py-2 border border-gray-300 rounded-xl shadow-sm focus:outline-none focus:ring-2 focus:ring-blue-500 text-sm"
                       placeholder="https://flagcdn.com/cr.svg">
            </div>

            <div>
                <label for="creador" class="block text-sm font-medium text-gray-400 mb-1">Creador:</label>
                <input type="text" id="creador" name="creador" value="Fernanda" readonly
                       class="w-full px-3 py-2 border border-gray-200 bg-gray-50 text-gray-400 rounded-xl text-sm outline-none cursor-not-allowed">
            </div>

            <div class="pt-4 flex justify-end">
                <button type="submit" class="bg-blue-600 hover:bg-blue-700 text-white font-semibold py-2.5 px-6 rounded-xl text-sm shadow-sm transition duration-150">
                    Agregar País
                </button>
            </div>
        </form>
    </div>
</div>
<script>
    document.getElementById('addPaisForm').addEventListener('submit', async function (event) {
        event.preventDefault();

        // Obtener y limpiar los valores del formulario
        const nombre = document.getElementById('nombreOficial').value.trim();
        const area = parseFloat(document.getElementById('area').value);
        const poblacion = parseInt(document.getElementById('poblacion').value);
        const creador = document.getElementById('creador').value.trim() || 'Fernanda';
        const bandera = document.getElementById('bandera').value.trim();

        // Convertir textos separados por comas a Arrays limpios
        const capital = document.getElementById('capital').value.split(',').map(p => p.trim()).filter(p => p !== '');
        const limites = document.getElementById('limites').value.split(',').map(l => l.trim().toUpperCase()).filter(l => l !== '');
        const zonasHorarias = document.getElementById('zonasHorarias').value.split(',').map(z => z.trim()).filter(z => z !== '');

        // =========================
        // VALIDACIONES
        // =========================
        const errors = [];

        // Validación de Nombre debe tener entre 3 y 90 caracteres
        if (!nombre) {
            errors.push("El nombre del país es obligatorio.");
        } else {
            if (nombre.length < 3) errors.push("El nombre del país debe tener mínimo 3 caracteres.");
            if (nombre.length > 90) errors.push("El nombre del país debe tener máximo 90 caracteres.");
        }

        // Validación de Capital cada capital debe tener entre 3 y 90 caracteres
        if (capital.length === 0) {
            errors.push("Debes agregar al menos una capital.");
        } else {
            capital.forEach((cap, index) => {
                if (cap.length < 3) errors.push(`La capital "${cap}" debe tener mínimo 3 caracteres.`);
                if (cap.length > 90) errors.push(`La capital "${cap}" debe tener máximo 90 caracteres.`);
            });
        }

        // Validación de Límites (3 letras mayúsculas)
        if (limites.length > 0) {
            limites.forEach((limite, index) => {
                if (!/^[A-Z]{3}$/.test(limite)) {
                    errors.push(`El límite #${index + 1} "${limite}" debe ser un código de 3 letras mayúsculas.`);
                }
            });
        }

        // Validación de Área números positivos
        if (isNaN(area) || area <= 0) {
            errors.push("El área debe ser un número positivo.");
        }

        // Validación de Población enteros positivos
        if (isNaN(poblacion) || poblacion <= 0 || !Number.isInteger(poblacion)) {
            errors.push("La población debe ser un número entero positivo.");
        }
        
        // Validación de Bandera
        if (!bandera) {
            errors.push("La URL de la bandera es obligatoria.");
        }

        // Si hay errores, frenamos el envío y los mostramos
        if (errors.length > 0) {
            alert("Por favor corrige los siguientes errores:\n\n" + errors.join("\n"));
            return; 
        }

        // Envío de datos al Backend mediante Fetch
        try {
            // Nota: Mapeamos los nombres exactos que espera recibir tu controlador/modelo
            const response = await fetch('/api/paises', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json'
                },
                body: JSON.stringify({
                    nombreOficial: nombre, // Mongoose usa 'nombreOficial'
                    capital,
                    borders: limites,      // 
                    area,
                    population: poblacion, // Mongoose usa 'population'
                    timezones: zonasHorarias,
                    bandera,
                    creador,
                    tipoDocumento: "pais"  // Mongoose usa 'tipoDocumento'
                })
            });

            if (response.ok) {
                alert('¡País agregado exitosamente!');
                location.href = '/dashboard';
            } else {
                const errorData = await response.json();
                console.error('Error de validación del servidor:', errorData);
                alert('Error al agregar el país en el servidor.');
            }
        } catch (error) {
            console.error('Error en la petición Fetch:', error);
            alert('Error crítico al conectar con el servidor.');
        }
    }); 
</script>