<!--dashboard deberá mostrar un resumen de los países hispanohablantes, incluyendo su nombre, capital, población y bandera. Además, se pueden incluir gráficos o estadísticas relevantes sobre los países.
Mostrar por registro como mínimos el nombre o nombre oficial(o fallbacka name.official si no existe en español), 
capital, borders, area, population, timezones, creador.
AVANZADO:gini, suma de population, suma de area, promedio de gini.-->


<div class="container mx-auto px-4 py-8">
    <div class="bg-gradient-to-r from-blue-500 to-indigo-600 rounded-2xl p-6 text-white shadow-lg mb-8">
        <h1 class="text-3xl font-bold mb-2">Dashboard de Países Hispanohablantes</h1>
        <p class="text-blue-100 max-w-2xl">
            Bienvenidos al dashboard de países hispanohablantes. Aquí podrás encontrar información relevante sobre los
            países de habla hispana, incluyendo su nombre, capital, población y bandera.
        </p>
    </div>

    <div class="flex flex-wrap gap-4 justify-between items-center mb-6">
        <div class="flex gap-3">
            <a href="/dashboard/nuevo"
                class="bg-emerald-600 hover:bg-emerald-700 text-white font-semibold py-2 px-4 rounded-xl shadow-sm transition duration-150 inline-flex items-center gap-2">
                Agregar País
            </a>
        </div>
        <a href="/"
            class="bg-gray-100 hover:bg-gray-200 text-gray-700 font-medium py-2 px-4 rounded-xl transition duration-150 border border-gray-300">
            Volver a Inicio
        </a>
    </div>

    <div class="bg-white rounded-2xl shadow-sm border border-gray-200 overflow-hidden">
        <div class="overflow-x-auto">
            <table class="min-w-full divide-y divide-gray-200 text-left text-sm text-gray-700">

                <thead class="bg-gray-50 text-xs uppercase font-semibold text-gray-600 tracking-wider">
                    <tr>
                        <th scope="col" class="px-6 py-4">Bandera</th>
                        <th scope="col" class="px-6 py-4">Nombre Oficial</th>
                        <th scope="col" class="px-6 py-4">Capital</th>
                        <th scope="col" class="px-6 py-4">Límites / Fronteras</th>
                        <th scope="col" class="px-6 py-4">Área</th>
                        <th scope="col" class="px-6 py-4">Población</th>
                        <th scope="col" class="px-6 py-4">Gini</th>
                        <th scope="col" class="px-6 py-4">Zonas Horarias</th>
                        <!--<th scope="col" class="px-6 py-4">Creador</th>-->
                        <th scope="col" class="px-6 py-4 text-center">Acciones</th>
                    </tr>
                </thead>

                <tbody class="divide-y divide-gray-200 bg-white">
                    <% if (paises && paises.length> 0) { %>
                        <% paises.forEach(pais=> { %>
                            <tr class="hover:bg-gray-50/70 transition duration-150">

                                <td class="px-6 py-4 whitespace-nowrap">
                                    <img src="<%= pais.bandera %>" alt="Bandera de <%= pais.nombreOficial %>"
                                        class="w-14 h-9 object-cover rounded-md shadow-sm border border-gray-100">
                                </td>

                                <td class="px-6 py-4 font-semibold text-gray-900 whitespace-nowrap">
                                    <%= pais.nombreOficial || (pais.name && pais.name.common) || 'N/A' %>
                                </td>

                                <td class="px-6 py-4 whitespace-nowrap">
                                    <%= pais.capital && pais.capital.length> 0 ? pais.capital[0] : 'N/A' %>
                                </td>

                                <td class="px-6 py-4 max-w-xs truncate font-mono text-xs text-gray-600">
                                    <%= pais.borders && pais.borders.length> 0 ? pais.borders.join(', ') : 'Ninguno' %>
                                </td>

                                <td class="px-6 py-4 whitespace-nowrap">
                                    <%= pais.area ? pais.area.toLocaleString() + ' km²' : 'N/A' %>
                                </td>

                                <td class="px-6 py-4 whitespace-nowrap">
                                    <%= pais.population ? pais.population.toLocaleString() : '0' %>
                                </td>
                                <td class="px-6 py-4 whitespace-nowrap">
                                    <%= pais.gini !==undefined ? pais.gini : 'N/A' %>
                                        <!--Si gini es 0, lo mostramos como 0, si no existe o es undefined, mostramos N/A-->
                                </td>

                                <td class="px-6 py-4 text-xs text-gray-500 max-w-xs truncate">
                                    <%= pais.timezones && pais.timezones.length> 0 ? pais.timezones.join(', ') : 'N/A'
                                        %>
                                </td>

                                <!--<td class="px-6 py-4 whitespace-nowrap">
                                    <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-blue-50 text-blue-700 border border-blue-100">
                                        <%= pais.creador || 'Fernanda' %>
                                    </span>
                                </td>-->

                                <td class="px-6 py-4 whitespace-nowrap text-center text-xs font-medium">
                                    <div class="flex justify-center items-center gap-2">
                                        <button
                                            class="bg-blue-50 hover:bg-blue-100 text-blue-600 py-1 px-2.5 rounded transition duration-150 border border-blue-200 btn-edit"
                                            onclick="editar('<%= pais._id %>')">
                                            Modificar
                                        </button>
                                        <button
                                            class="bg-red-50 hover:bg-red-100 text-red-600 py-1 px-2.5 rounded transition duration-150 border border-red-200 btn-delete"
                                            onclick="eliminar('<%= pais._id %>', '<%= pais.nombreOficial %>')">
                                            Eliminar
                                        </button>
                                    </div>
                                </td>
                            </tr>

                            <% }) %>
                                <% } else { %>
                                    <tr>
                                        <td colspan="9" class="px-6 py-12 text-center text-gray-500">
                                            <p class="text-base font-semibold">No hay países hispanohablantes
                                                registrados en tu base de datos.</p>
                                            <p class="text-sm mt-1">Por favor verifica la sincronización de la API.</p>
                                        </td>
                                    </tr>
                                    <% } %>
                                    <!------------Codigo para agregar Totales-->
                <% <!--Inicializamos las variables acumuladoras antes del bucle-->
                    let totalArea = 0;
                    let totalPoblacion = 0;
                    let sumaGini = 0;
                    let paisesConGini = 0;

                    paises.forEach(pais => {
                    <!--Acumulamos los valores de cada país en este ciclo-->
                    totalArea += pais.area || 0;
                    totalPoblacion += pais.population || 0;

                    if (pais.gini && pais.gini > 0) {
                    sumaGini += pais.gini;
                    paisesConGini++; <!--Contamos cuántos países aportaron al Gini-->
                    }
                    %>
                    <!-- <tr>
                <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-600">
                    <%= pais.area.toLocaleString() %> km²
                </td>
                <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-600">
                    <%= pais.population.toLocaleString() %>
                </td>
                <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-600 font-mono">
                    <%= pais.gini && pais.gini > 0 ? pais.gini + '%' : 'N/A' %>
                </td>
                <td class="px-6 py-4 whitespace-nowrap text-right text-sm font-medium">
                    </td>
            </tr> -->
                    <% }) %>
                        <% <!--Calcular el promedio del Gini de forma segura para evitar división por cero-->
                            let promedioGini = paisesConGini > 0 ? (sumaGini / paisesConGini).toFixed(1) : 0;
                            %>
                            <tr class="bg-gray-50 font-bold border-t-2 border-gray-300">
                                <td ></td>
                                <td ></td>
                                <td ></td>
                                <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-800">TOTALES / PROMEDIOS</td>
                                
                                <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900">
                                     <%= totalArea.toLocaleString() %> km²
                                </td>

                                <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900">
                                   <%= totalPoblacion.toLocaleString() %>
                                </td>

                                <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900 font-mono">
                                    <%= promedioGini> 0 ? promedioGini + '% (Prom)' : 'N/A' %>
                                </td>

                                <td></td>
                                                                <td ></td>

                            </tr>


                            <!-------------Fin codigo Agregar Totales-->

                </tbody>
                

            </table>
        </div>
    </div>
</div>
<script>
    async function editar(id) {
        console.log("ID del héroe a editar:", id); // Verifica que el ID se reciba correctamente                           
        // Redirigimos a la página de edición con el ID del héroe
        window.location.href = "/dashboard/modificar/" + id;
    }
    async function eliminar(id, nombre) {
        const confirmar = confirm("¿Estás seguro que deseas eliminar a " + nombre + "? Esta acción no se puede deshacer.");

        if (!confirmar) return;

        try {
            const res = await fetch("/api/paises/id/" + id, { method: "DELETE" });

            if (res.ok) {
                //
                alert(nombre + " eliminado correctamente."); // 
                // Refrescamos la página para que desaparezca de la lista
                window.location.reload();
            } else {
                const errorData = await res.json();
                alert("Error al eliminar: " + (errorData.mensaje || "Error desconocido"));
            }
        } catch (error) {
            console.error("Error en la petición:", error);
            alert("No se pudo conectar con el servidor.");
        }
    }
</script>