<div class="container mx-auto px-4 py-8">
        <div class="bg-gradient-to-r from-blue-500 to-indigo-600 rounded-2xl p-6 text-white shadow-lg mb-8">
        <h1 class="text-3xl font-bold mb-2">Dashboard de Países Hispanohablantes</h1>
        <p class="text-blue-100 max-w-2xl">
            Bienvenidos al dashboard de países hispanohablantes. Aquí podrás encontrar información relevante sobre los países de habla hispana, incluyendo su nombre, capital, población y bandera.
        </p>
    </div>

    <div class="flex flex-wrap gap-4 justify-between items-center mb-6">
        <div class="flex gap-3">
            <a href="/dashboard/nuevo" class="bg-emerald-600 hover:bg-emerald-700 text-white font-semibold py-2 px-4 rounded-xl shadow-sm transition duration-150 inline-flex items-center gap-2">
                <!-- <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor">
                    <path fill-rule="evenodd" d="M10 3a1 1 0 011 1v5h5a1 1 0 110 2h-5v5a1 1 0 11-2 0v-5H4a1 1 0 110-2h5V4a1 1 0 011-1z" clip-rule="evenodd" />
                </svg> -->
                Agregar País
            </a>
        </div>
        <a href="/" class="bg-gray-100 hover:bg-gray-200 text-gray-700 font-medium py-2 px-4 rounded-xl transition duration-150 border border-gray-300">
            Volver a Inicio
        </a>
    </div>

    <div class="bg-white rounded-2xl shadow-sm border border-gray-200 overflow-hidden">
        <div class="overflow-x-auto">
            <table class="min-w-full divide-y divide-gray-200 text-left text-sm text-gray-700">
                
                <thead class="bg-gray-50 text-xs uppercase font-semibold text-gray-600 tracking-wider">
                    <tr>
                        <th scope="col" class="px-6 py-4">Bandera</th>
                        <th scope="col" class="px-6 py-4">Nombre Oficial</th>
                        <th scope="col" class="px-6 py-4">Capital</th>
                        <th scope="col" class="px-6 py-4">Límites / Fronteras</th>
                        <th scope="col" class="px-6 py-4">Área</th>
                        <th scope="col" class="px-6 py-4">Población</th>
                        <th scope="col" class="px-6 py-4">Zonas Horarias</th>
                        <!--<th scope="col" class="px-6 py-4">Creador</th>-->
                        <th scope="col" class="px-6 py-4 text-center">Acciones</th>
                    </tr>
                </thead>
                
                <tbody class="divide-y divide-gray-200 bg-white">
                    <% if (paises && paises.length > 0) { %>
                        <% paises.forEach(pais => { %>
                            <tr class="hover:bg-gray-50/70 transition duration-150">
                                
                                <td class="px-6 py-4 whitespace-nowrap">
                                    <img src="<%= pais.bandera %>" alt="Bandera de <%= pais.nombreOficial %>" class="w-14 h-9 object-cover rounded-md shadow-sm border border-gray-100">
                                </td>
                                
                                <td class="px-6 py-4 font-semibold text-gray-900 whitespace-nowrap">
                                    <%= pais.nombreOficial || (pais.name && pais.name.common) || 'N/A' %>
                                </td>
                                
                                <td class="px-6 py-4 whitespace-nowrap">
                                    <%= pais.capital && pais.capital.length > 0 ? pais.capital[0] : 'N/A' %>
                                </td>
                                
                                <td class="px-6 py-4 max-w-xs truncate font-mono text-xs text-gray-600">
                                    <%= pais.borders && pais.borders.length > 0 ? pais.borders.join(', ') : 'Ninguno' %>
                                </td>
                                
                                <td class="px-6 py-4 whitespace-nowrap">
                                    <%= pais.area ? pais.area.toLocaleString() + ' km²' : 'N/A' %>
                                </td>
                                
                                <td class="px-6 py-4 whitespace-nowrap">
                                    <%= pais.population ? pais.population.toLocaleString() : '0' %>
                                </td>
                                
                                <td class="px-6 py-4 text-xs text-gray-500 max-w-xs truncate">
                                    <%= pais.timezones && pais.timezones.length > 0 ? pais.timezones.join(', ') : 'N/A' %>
                                </td>
                                
                                <!--<td class="px-6 py-4 whitespace-nowrap">
                                    <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-blue-50 text-blue-700 border border-blue-100">
                                        <%= pais.creador || 'Fernanda' %>
                                    </span>
                                </td>-->
                                
                                <td class="px-6 py-4 whitespace-nowrap text-center text-xs font-medium">
                                    <div class="flex justify-center items-center gap-2">
                                        <button class="bg-blue-50 hover:bg-blue-100 text-blue-600 py-1 px-2.5 rounded transition duration-150 border border-blue-200 btn-edit" onclick="editar('<%= pais._id %>')">
                                            Modificar
                                        </button>
                                        
                                        <button onclick="location.href='/dashboard/eliminar/<%= pais.cca3 %>'" class="bg-red-50 hover:bg-red-100 text-red-600 py-1 px-2.5 rounded transition duration-150 border border-red-200">
                                            Eliminar
                                        </button>
                                        <button class="bg-red-600 hover:bg-red-700 text-white py-1 px-2.5 rounded shadow-sm transition duration-150 btn-delete" onclick="eliminar('<%= pais._id %>', '<%= pais.nombreOficial %>')">
                                            Borrar
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        <% }) %>
                    <% } else { %>
                        <tr>
                            <td colspan="9" class="px-6 py-12 text-center text-gray-500">
                                <p class="text-base font-semibold">No hay países hispanohablantes registrados en tu base de datos.</p>
                                <p class="text-sm mt-1">Por favor verifica la sincronización de la API.</p>
                            </td>
                        </tr>
                    <% } %>
                </tbody>
            </table>
        </div>
    </div>
</div>
<script>
    async function editar(id) {
        console.log("ID del héroe a editar:", id); // Verifica que el ID se reciba correctamente                           
        // Redirigimos a la página de edición con el ID del héroe
        window.location.href = "/dashboard/modificar/" + id;
    } 
</script>