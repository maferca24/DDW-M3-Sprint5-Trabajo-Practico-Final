<div class="container mx-auto px-4 py-12 md:py-24">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-12 items-center">
        
        <div class="space-y-6 text-center md:text-left">
            <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-semibold bg-blue-50 text-blue-600 border border-blue-100 tracking-wide uppercase">
                Diplomatura Full Stack &bull; Módulo 3- Trabajo Final
            </span>
            
            <h1 class="text-4xl md:text-5xl lg:text-6xl font-extrabold text-gray-900 tracking-tight leading-none">
                <%= title %>
            </h1>
            
            <div class="space-y-3">
                <p class="text-lg md:text-xl text-gray-600 font-medium">
                    Bienvenidos a la aplicación de Gestión de Países.
                </p>
                <p class="text-base text-gray-500 max-w-md mx-auto md:mx-0">
                    Un sistema completo para explorar, administrar y analizar información clave de los países hispanohablantes del continente americano.
                </p>
            </div>
            
            <div class="flex justify-center md:justify-start items-center gap-2 text-xs text-gray-400">
               <span>Datos integrados en tiempo real desde la API externa <strong>REST Countries</strong></span>
            </div>

            <div class="pt-2">
                <button onclick="location.href='/dashboard'" 
                        class="group relative inline-flex items-center justify-center bg-blue-600 hover:bg-blue-700 text-white font-bold py-4 px-8 rounded-2xl shadow-lg hover:shadow-blue-200 transition duration-200 transform hover:-translate-y-0.5 text-base gap-2 w-full sm:w-auto">
                    Ingresar al Dashboard
            </button>
            </div>
        </div>
        <div class="flex justify-center items-center">
            <div class="relative w-full max-w-lg">                
                <img src="/images/america_latina.png" alt="Mapamundi y países" class="w-65 h-65">
            </div>
        </div>

    </div>
</div>